      "q": "Find all values of $\\mu$ that satisfy:\n$$\\begin{vmatrix} \\mu-1 & 4 \\\\ 1 & \\mu+2 \\end{vmatrix}=0$$",
      "t": [
        "تمرين",
        "Cofactor Expansion"

          "i": "2",
          "x": "$\\mu=-2$ or $\\mu=3$"
        },
        {
          "i": "3",
          "x": "$\\mu=2$ or $\\mu=-3$"
        },
        {
          "i": "4",
          "x": "$\\mu=3$ or $\\mu=2$"
        }
